<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".cameraphotoedit">
    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="400dp"
        android:layout_height="500dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/cream"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Original Image (Before) -->
        <ImageView
            android:id="@+id/imageViewlive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@color/white"
            android:scaleType="fitXY"
            android:src="@drawable/ic_launcher_background"
            tools:ignore="ContentDescription" />

        <!-- After Image (Overlay) -->
        <!-- Ensures it's above the original image -->

        <!-- Vertical Separator Line -->
        <ImageView
            android:id="@+id/frameImageViewlive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cream"
            android:backgroundTint="@color/white"
            android:backgroundTintMode="src_over"
            android:elevation="2dp"
            android:scaleType="fitXY"
            tools:ignore="ContentDescription" />

        <View
            android:id="@+id/separatorlive"
            android:layout_width="4dp"
            android:layout_height="match_parent"

            android:elevation="3dp" />

        <ImageView
            android:id="@+id/image_view_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="10dp"
            app:srcCompat="@drawable/camrea_backgrond" /> <!-- Ensures it's visible above the images -->

    </FrameLayout>

    <!-- SeekBar to Adjust Before-After Split -->
    <SeekBar
        android:id="@+id/seekBarlive"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:max="100"
        android:progress="50"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageContainer" />


    <!-- Button to Select Image -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/clickimageButtonlive"
        android:layout_width="130dp"
        android:layout_height="60dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/login_button"
        android:drawableStart="@drawable/camera_buttom"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Click Picture"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/seekBarlive" />
</androidx.constraintlayout.widget.ConstraintLayout>